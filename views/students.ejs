<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students Registry</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <div class="sidebar">
        <h2>Library</h2>
        <a href="/dashboard">Dashboard</a>
        <a href="/books">Books</a>
        <a href="/borrow">Borrowed books</a>
        <a href="/students" class="active">Students</a>
        <a href="/visits">Library Visits</a>
        <a href="/logout">Logout</a>
    </div>

    <div class="main">
        <h1>Student Registry</h1>

        <div class="search-flex-container">
            <a href="/students/add" class="btn-add-book">Register New Student</a>

            <form action="/students" method="GET" class="search-bar-form">
                <input type="text" name="search" class="search-input-field" placeholder="Search by Student USN..."
                    value="<%= typeof search !== 'undefined' ? search : '' %>">
                <button type="submit" class="btn-search-submit">Search</button>
                <% if (typeof search !=='undefined' && search) { %>
                    <a href="/students" class="btn-search-clear">Clear Filter</a>
                <% } %>
            </form>
        </div>

        <div class="main-page">
            <table>
                <tr>
                    <th>USN</th>
                    <th>Full Name</th>
                    <th>Branch / Department</th>
                    <th>Actions</th>
                </tr>
                <% students.forEach(student=> { %>
                    <tr>
                        <td><strong><%= student.USN %></strong></td>
                        <td><%= student.FULLNAME %></td>
                        <td><%= student.BRANCH %></td>
                        <td>
                            <a href="/students/edit/<%= student.USN %>" class="btn-action-edit">Edit</a>
                            <a href="/students/delete/<%= student.USN %>" class="btn-action-delete"
                                onclick="return confirm('Are you sure you want to remove this student profile?')">Delete</a>
                        </td>
                    </tr>
                <% }) %>
            </table>
        </div>
    </div>
</body>

</html>