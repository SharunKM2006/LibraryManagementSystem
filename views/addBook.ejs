<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Book</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <div class="sidebar">
        <h2>Library</h2>
        <a href="/dashboard">Dashboard</a>
        <a href="/books" class="active">Books</a>
        <a href="/borrow">Borrowed books</a>
        <a href="/students">Students</a>
        <a href="/visits">Library Visits</a>
        <a href="/logout">Logout</a>
    </div>

    <div class="main">
        <h1>Catalog Management</h1>

        <div class="main-page form-container-box">
            <h3 class="form-title">Add New Book Entry</h3>

            <form action="/books/add" method="POST">
                <div class="input-group">
                    <label class="form-label">Book Title</label>
                    <input type="text" name="title" placeholder="e.g., To Kill a Mockingbird" required>
                </div>

                <div class="input-group">
                    <label class="form-label">Author Name</label>
                    <input type="text" name="author" placeholder="e.g., Harper Lee" required>
                </div>

                <div class="input-group">
                    <label class="form-label">Stock Quantity</label>
                    <input type="number" name="quantity" placeholder="e.g., 12" min="1" required>
                </div>

                <button type="submit" class="btn-submit-form">Add to Inventory</button>
            </form>

            <a href="/books" class="btn-cancel-link">&larr; Cancel and Go Back</a>
        </div>
    </div>
</body>

</html>