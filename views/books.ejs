<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Books Catalog</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <div class="sidebar">
        <h2>Library</h2>
        <a href="/dashboard">Dashboard</a>
        <a href="/books" class="active">Books</a>
        <a href="/borrow">Borrowed books</a>
        <a href="/students">Students</a>
        <a href="/visits">Library Visits</a>
        <a href="/logout">Logout</a>
    </div>

    <div class="main">
        <h1>Books Management</h1>

        <div class="search-flex-container">
            <a href="/books/add" class="btn-add-book">Add New Book Entry</a>
        </div>

        <div class="main-page">
            <table>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Quantity</th>
                    <th>Actions</th>
                </tr>
                <% books.forEach(book=> { %>
                    <tr>
                        <td><code>#<%= book.BOOKID %></code></td>
                        <td><strong><%= book.TITLE %></strong></td>
                        <td><%= book.AUTHOR %></td>
                        <td><%= book.QUANTITY %> units</td>
                        <td>
                            <a href="/books/edit/<%= book.BOOKID %>" class="btn-action-edit">Edit</a>
                            <a href="/books/delete/<%= book.BOOKID %>" class="btn-action-delete"
                                onclick="return confirm('Are you sure you want to delete this book?')">Delete</a>
                        </td>
                    </tr>
                <% }) %>
            </table>
        </div>
    </div>
</body>

</html>