<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Borrowed Books</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <div class="sidebar">
        <h2>Library</h2>
        <a href="/dashboard">Dashboard</a>
        <a href="/books">Books</a>
        <a href="/borrow" class="active">Borrowed books</a>
        <a href="/students">Students</a>
        <a href="/visits">Library Visits</a>
        <a href="/logout">Logout</a>
    </div>

    <div class="main">
        <h1>Circulation Management</h1>

        <div class="search-flex-container">
            <a href="/borrow/add" class="btn-add-book">Issue New Book</a>

            <form action="/borrow" method="GET" class="search-bar-form">
                <input type="text" name="search" class="search-input-field" placeholder="Search by Student USN..."
                    value="<%= typeof search !== 'undefined' ? search : '' %>">
                <button type="submit" class="btn-search-submit">Search</button>
                <% if (typeof search !== 'undefined' && search) { %>
                    <a href="/borrow" class="btn-search-clear">Clear Filter</a>
                <% } %>
            </form>
        </div>

        <div class="main-page">
            <table>
                <tr>
                    <th>Tx ID</th>
                    <th>Student USN</th>
                    <th>Book ID</th>
                    <th>Borrow Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
                <% borrowRecords.forEach(record=> { %>
                    <tr>
                        <td><code>#<%= record.ID %></code></td>
                        <td><strong><%= record.USN %></strong></td>
                        <td><code>#<%= record.BOOKID %></code></td>
                        <td><%= record.BORROW_DATE %></td>
                        <td><%= record.RETURN_DATE %></td>
                        <td>
                            <span class="status-badge status-<%= record.STATUS.toLowerCase() %>">
                                <%= record.STATUS %>
                            </span>
                        </td>
                        <td>
                            <% if(record.STATUS==='Active' || record.STATUS==='Borrowed' ) { %>
                                <form action="/borrow/return/<%= record.ID %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn-action-edit" style="background-color: var(--success-bg); color: var(--success);">Mark Returned</button>
                                </form>
                            <% } else { %>
                                <span style="color: var(--text-muted); font-size: 0.85rem; font-weight: 600;">Transaction Closed</span>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </table>
        </div>
    </div>
</body>

</html>