<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="sidebar">
        <h2>Library</h2>
        <a href="/dashboard" class="active">Dashboard</a>
        <a href="/books">Books</a>
        <a href="/borrow">Borrowed books</a>
        <a href="/students">Students</a>
        <a href="/visits">Library Visits</a>
        <a href="/logout">Logout</a>
    </div>

    <div class="main">
        <h1>Welcome back, <%= librarian ? librarian.FULLNAME : 'Librarian' %></h1>
        
        <div class="cards">
            <div class="card">
                <h2><%= TOTAL_BOOKS %></h2>
                <p>Total Books</p>
            </div>
            <div class="card">
                <h2><%= TOTAL_BORROWED %></h2>
                <p>Total Borrowed</p>
            </div>
            <div class="card">
                <h2><%= TOTAL_VISITS %></h2>
                <p>Total Visits</p>
            </div>
        </div>
    </div>
</body>
</html>