<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Issue Book</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <div class="sidebar">
        <h2>Library</h2>
        <a href="/dashboard">Dashboard</a>
        <a href="/books">Books</a>
        <a href="/borrow" class="active">Borrowed books</a>
        <a href="/students">Students</a>
        <a href="/visits">Library Visits</a>
        <a href="/logout">Logout</a>
    </div>

    <div class="main">
        <h1>Circulation Management</h1>

        <div class="main-page form-container-box">
            <h3 class="form-title">Issue Book to Student</h3>

            <form action="/borrow/add" method="POST">
                <div class="input-group">
                    <label class="form-label">Student USN</label>
                    <input type="text" name="usn" placeholder="Enter student's exact USN" required>
                </div>

                <div class="input-group">
                    <label class="form-label">Book Identification ID</label>
                    <input type="number" name="bookid" placeholder="Enter systemic Book ID" required>
                </div>

                <div class="input-group">
                    <label class="form-label">Date of Borrow</label>
                    <input type="date" name="borrow_date" required>
                </div>

                <div class="input-group">
                    <label class="form-label">Expected Return Deadline</label>
                    <input type="date" name="return_date" required>
                </div>

                <button type="submit" class="btn-submit-form">Confirm & Issue Item</button>
            </form>

            <a href="/borrow" class="btn-cancel-link">&larr; Cancel Transaction</a>
        </div>
    </div>
</body>

</html>