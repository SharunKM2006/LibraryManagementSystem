<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <div class="sidebar">
        <h2>Library</h2>
        <a href="/dashboard">Dashboard</a>
        <a href="/books">Books</a>
        <a href="/borrow">Borrowed books</a>
        <a href="/students" class="active">Students</a>
        <a href="/visits">Library Visits</a>
        <a href="/logout">Logout</a>
    </div>

    <div class="main">
        <h1>Student Registry</h1>

        <div class="main-page form-container-box">
            <h3 class="form-title">Modify Student Profile</h3>

            <form action="/students/edit/<%= student.USN %>" method="POST">
                <div class="input-group">
                    <label class="form-label">USN (Read-Only)</label>
                    <input type="text" name="usn" value="<%= student.USN %>" readonly
                        style="background-color: var(--bg-main); color: var(--text-muted); cursor: not-allowed;">
                </div>

                <div class="input-group">
                    <label class="form-label">Full Name</label>
                    <input type="text" name="fullname" value="<%= student.FULLNAME %>" required>
                </div>

                <div class="input-group">
                    <label class="form-label">Branch / Department</label>
                    <input type="text" name="branch" value="<%= student.BRANCH %>" required>
                </div>

                <button type="submit" class="btn-submit-form">Save Changes</button>
            </form>

            <a href="/students" class="btn-cancel-link">&larr; Cancel and Go Back</a>
        </div>
    </div>
</body>

</html>